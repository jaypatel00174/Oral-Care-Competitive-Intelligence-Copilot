# Copy to .env and fill in. Never commit .env or real keys.
# Values in .env win over variables already exported in your shell.
#
# Leave LLM_MODEL empty to run without any LLM: the assistant then answers with its offline
# writer (still cited and grounded). Set it to use a model through any OpenAI-compatible endpoint.
#
# Local Ollama (open source, no key):
#   LLM_BASE_URL=http://localhost:11434/v1
#   LLM_MODEL=qwen2.5:7b
# Google Gemini (free key from https://aistudio.google.com/apikey), two ways:
#   a) Native API (recommended; needed for AGENT mode with Gemini 3, which requires "thought signatures"
#      on tool calls that only the native client sends back). LLM_BASE_URL is not used.
#        LLM_PROVIDER=google
#        LLM_MODEL=gemini-flash-lite-latest
#        LLM_MIN_INTERVAL=4.5
#   b) OpenAI-compatible endpoint (pipeline mode only; agent mode fails with "missing a thought_signature").
#        LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#        LLM_MODEL=gemini-flash-lite-latest
# Model names change; list the ones your key can use in Google AI Studio.
#
# LLM_PROVIDER: openai (default: any OpenAI-compatible endpoint, including Ollama) or google (native Gemini).
LLM_PROVIDER=openai
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
# Optional. 0 = same question, same answer (default).
LLM_TEMPERATURE=0

# Optional. Seconds to wait between model calls. Free hosted tiers allow only a few requests per
# minute and answer HTTP 429 above that; about 4.5 suits Gemini's free tier. 0 = no wait (Ollama).
LLM_MIN_INTERVAL=0
# Optional. Retries after a transient error such as 429, with backoff.
LLM_MAX_RETRIES=3

# Logging (all optional). Logs go to stderr; add LOG_FILE to also write a rotating file.
#   LOG_LEVEL: DEBUG | INFO | WARNING | ERROR. Default INFO for the API and MCP server, WARNING for the CLI.
#   LOG_FORMAT: text (default) or json (one object per line). Keys and answer text are never logged.
LOG_LEVEL=
LOG_FORMAT=text
LOG_FILE=

# Optional: a different model to fact-check answers in the evaluation (LLM-as-judge), so a model
# does not grade its own writing. Uses the same LLM_PROVIDER, LLM_BASE_URL and LLM_API_KEY. Empty = same model.
JUDGE_MODEL=
